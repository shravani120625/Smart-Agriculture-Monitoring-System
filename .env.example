# -------------------------------------------------------------------------
# IoT Smart Agriculture - Environment Variables Example
# Copy this file to '.env' and fill in your private credentials.
# -------------------------------------------------------------------------

# WiFi Configuration (Hardware specific)
WIFI_SSID=Wokwi-GUEST
WIFI_PASSWORD=

# MQTT Broker Configuration
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=ESP32_SmartFarm_Node1
MQTT_TELEMETRY_TOPIC=farm/node1/data
MQTT_STATUS_TOPIC=farm/node1/status

# ThingSpeak Configuration
THINGSPEAK_CHANNEL_ID=3404714
THINGSPEAK_WRITE_API_KEY=NIK2WVQVX50V58H4
THINGSPEAK_READ_API_KEY=YOUR_READ_API_KEY_HERE
